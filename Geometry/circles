
using pd = pair<double,double>;
using pdd = pair<pair<double,double>,pair<double,double>>;
// the center of the circle is the origin
pdd intersect_circle_vs_line(double r, double a, double b, double c, bool &f){
    double x0 = -c * a / (a * a + b * b), y0 = -c * b / (a * a + b * b);
    f = 1;
    if (c*c > r*r*(a*a+b*b)+EPS){//no intersection
        f = 0;
        return {{-1, -1}, {-1, -1}};
    }
    else if (abs(c * c - r * r * (a * a + b * b)) < EPS)return {{x0, y0}, {x0, y0}};// 1 point
    else{ // 2 points
        double d = r * r - c * c / (a * a + b * b);
        double mult = sqrt(d / (a * a + b * b));
        double ax, ay, bx, by;
        ax = x0 + b * mult;
        bx = x0 - b * mult;
        ay = y0 - a * mult;
        by = y0 + a * mult;
        return {{ax,ay},{bx,by}};
    }
}
pdd intersect_circle_vs_circle(double x1, double y1, double r1, double x2, double y2, double r2,bool &f) {
    double d = hypot(x1 - x2, y1 - y2);
    if (d < fabs(r1 - r2) || d > (r1 + r2 + EPS)) { // one inside the other
        f = 0;
        return {{-1, -1}, {-1, -1}};
    }
    double xx = x2 - x1, yy = y2 - y1;
    auto [a, b] = intersect_circle_vs_line(r1, -2 * xx, -2 * yy, xx * xx + yy * yy + r1 * r1 - r2 * r2, f);
    a.F += x1;
    a.S += y1;
    b.F += x1;
    b.S += y1;
    return {a, b};
}

void getTangents(pt c, double r1, double r2, vector<line> &ans) {
    double r = r2 - r1;
    double z = c.x * c.x + c.y * c.y;
    double d = z - r * r;
    if (d < -EPS)return;
    d = sqrt(abs(d));
    line l({0, 0});
    l.v.x = (c.x * r + c.y * d) / z;
    l.v.y = (c.y * r - c.x * d) / z;
    l.c = r1;
    ans.emplace_back(l);
}
vector<line> tangents(pt a, double r1, pt b, double r2) {
    vector<line> ans;
    for (int i = -1; i <= 1; i += 2) {
        for (int j = -1; j <= 1; j += 2) {
            getTangents(b - a, r1 * i, r2 * j, ans);
        }
    }
    for (int i = 0; i < ans.size(); ++i) {
        ans[i].c -= ans[i].v.x * a.x + ans[i].v.y * a.y;
    }
    return ans;
}
