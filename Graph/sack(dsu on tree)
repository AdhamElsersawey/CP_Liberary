 ll mx = 0;
    vector<ll> ans(n + 1), sz(n + 1), big(n + 1), sum(n + 1);
    function<void(ll,ll)> pre = [&](ll u,ll p) {
        sz[u] = 1;
        for (int v: adj[u]) {
            if (v == p)continue;
            pre(v, u);
            sz[u] += sz[v];
            if (!big[u] || sz[v] > sz[big[u]])big[u] = v;
        }
    };

// الكلام ده كله ثابت ماعدا دي و الحاجات الي جوا حسب انت عايز ايه 
    function<void(ll,ll)> update = [&](int c,int d) {
        if (fre[c] + d > mx)++mx;
        else if (fre[c] == mx && sum[fre[c]] == c)--mx;
        sum[fre[c]] -= c;
        fre[c] += d;
        sum[fre[c]] += c;
    };
    function<void(ll,ll,ll)> dfs2 = [&](int u,ll p,ll d) {
        update(col[u], d);


        for (auto v: adj[u]) {
            if (v == p)continue;

            dfs2(v, u, d);
        }
    };
    function<void(ll,ll,ll)> dfs = [&](int u,int p,ll stat) {
        for (ll v: adj[u]) {
            if (p == v || v == big[u])continue;
            dfs(v, u, 0);
        }
        if (big[u])
            dfs(big[u], u, 1);

        update(col[u], 1);
        for (ll v: adj[u]) {
            if (p == v || v == big[u])continue;
            dfs2(v, u, 1);
        }
        ans[u] = sum[mx];
        if (!stat)dfs2(u, p, -1);
    };
