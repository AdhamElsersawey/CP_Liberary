struct MF {
    // Edmonds-Karp: O(V * E^2)
    int n, st, target;
    vector<vector<ll> > adj;

    MF(int _n) {
        n = _n;
        adj = vector(n, vector(n, 0ll));
    }

    void add(int u, int v, ll w) {
        adj[u][v] += w;
    }

    ll get(vector<ll> &par, int u, ll mn) {
        if (u == st) return mn;
        ll mf = get(par, par[u], min(mn, adj[par[u]][u]));
        adj[par[u]][u] -= mf;
        adj[u][par[u]] += mf;
        return mf;
    }

    ll calc() {
        ll ans = 0;
        while (1) {
            queue<int> q;
            vector<ll> par(n, -1);
            q.push(st);
            par[st] = -2;
            while (!q.empty()) {
                int u = q.front();
                q.pop();
                for (int v = 0; v < n; v++) {
                    if (adj[u][v] == 0 || par[v] != -1) continue;
                    par[v] = u;
                    q.push(v);
                }

                if (par[target] != -1) break;
            }
            if (par[target] == -1) break;
            ans += get(par, target, OO);
        }
        return ans;
    }
};
