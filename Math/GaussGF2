int GaussGF2(vector<bitset<N> > &a, int n, int m, bitset<N> &ans) {
    vector<int> pos(m, -1);
    int free_var = 0;
    int row = 0;

    for (int col = 0; col < m && row < n; ++col) {
        int pivot = row;
        for (int i = row; i < n; ++i) {
            if (a[i][col]) {
                pivot = i;
                break;
            }
        }
        if (!a[pivot][col]) {
            continue;
        }
        swap(a[row], a[pivot]);
        pos[col] = row;
        for (int i = 0; i < n; ++i) {
            if (i != row && a[i][col]) {
                a[i] ^= a[row];
            }
        }
        row++;
    }
    ans.reset();
    for (int i = 0; i < m; ++i) {
        if (pos[i] != -1) {
            ans[i] = a[pos[i]][m];
        } else {
            free_var++;
        }
    }
    for (int i = 0; i < n; ++i) {
        bool sum = 0;
        for (int j = 0; j < m; ++j) {
            if (ans[j]) sum ^= a[i][j];
        }
        if (sum != a[i][m]) return -1;
    }

    return free_var;
}
