 // Returns gcd(a, b), and finds x and y such that ax + by = gcd(a, b)
long long extended_gcd(int a, int b, long long &x, long long &y) {
    if (b == 0) {
        x = 1, y = 0;
        return a;
    }
    long long x1, y1;
    long long g = extended_gcd(b, a % b, x1, y1);
    x = y1, y = x1 - (a / b) * y1;
    return g;
}
 
