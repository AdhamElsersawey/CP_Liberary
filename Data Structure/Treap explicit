mt19937_64 rng(chrono::steady_clock::now().time_since_epoch().count());
// الترتيب بيكون بالقيم الي داخله
template<typename T>
struct Treap {
    // val -> the node value
    // sum->the sum of the subtree
    // like set ,map
    struct Node {
        T key, val, sum;
        T lazy = 0;
        int sz = 1, rv = 0;
        uint64_t p = rng();
        Node *l = nullptr, *r = nullptr;

        Node(T k, T v = T()) : key(k), val(v), sum(v) {
        }
    } *root = nullptr;

    ~Treap() { destroy(root); }

    void destroy(Node *t) {
        if (!t) return;
        destroy(t->l);
        destroy(t->r);
        delete t;
    }

    int sz(Node *t) { return t ? t->sz : 0; }
    T sum(Node *t) { return t ? t->sum : 0; }

    void push(Node *t) {
        if (!t || t->lazy == 0) return;
        t->val += t->lazy;
        t->sum += t->lazy * sz(t);
        if (t->l) t->l->lazy += t->lazy;
        if (t->r) t->r->lazy += t->lazy;
        t->lazy = 0;
    }

    Node *update(Node *t) {
        if (t) {
            t->sz = 1 + sz(t->l) + sz(t->r);
            t->sum = t->val + sum(t->l) + sum(t->r);
        }
        return t;
    }


    Node *merge(Node *l, Node *r) {
        push(l);
        push(r);
        if (!l || !r) return l ? l : r;
        if (l->p > r->p) {
            l->r = merge(l->r, r);
            return update(l);
        }
        r->l = merge(l, r->l);
        return update(r);
    }

    pair<Node *, Node *> split(Node *t, T k) {
        if (!t) return {nullptr, nullptr};
        push(t);
        if (t->key <= k) {
            auto [l, r] = split(t->r, k);
            t->r = l;
            return {update(t), r};
        }
        auto [l, r] = split(t->l, k);
        t->l = r;
        return {l, update(t)};
    }

    void add_range(T l_val, T r_val, T add_val) {
        if (l_val > r_val) return;

        auto [left_mid, right] = split(root, r_val);
        auto [left, mid] = split(left_mid, l_val - 1);

        if (mid) {
            mid->lazy += add_val;
        }

        root = merge(merge(left, mid), right);
    }

    T query(int l,int r) {
        if (l > r) return 0;
        auto [left_mid, right] = split(root, r);
        auto [left, mid] = split(left_mid, l - 1);
        ll ret = sum(mid);
        root = merge(merge(left, mid), right);
        return ret;
    }

    bool search(T x) {
        Node *curr = root;
        while (curr) {
            push(curr);
            if (curr->key == x) return true;
            curr = (x < curr->key) ? curr->l : curr->r;
        }
        return false;
    }

    void insert(int x, T val = T()) {
        auto [l, r] = split(root, x);
        auto [l2, r2] = split(l, x - 1);
        if (!r2) {
            r2 = new Node(x, val);
        } else {
            push(r2);
            r2->val += val;
            update(r2);
        }
        root = merge(merge(l2, r2), r);
    }

    void erase(T x) {
        auto [l, r] = split(root, x);
        auto [l2, r2] = split(l, x - 1);
        destroy(r2);
        root = merge(l2, r);
    }


    Node *find_by_order(Node *t, int k) {
        if (!t) return nullptr;
        push(t);
        int left_sz = sz(t->l);
        if (k < left_sz) return find_by_order(t->l, k);
        if (k == left_sz) return t;
        return find_by_order(t->r, k - left_sz - 1);
    }

    Node *find_by_order(int k) { return find_by_order(root, k); }

    int order_of_key(Node *t, T k) {
        if (!t) return 0;
        push(t);
        if (t->key >= k) return order_of_key(t->l, k);
        return sz(t->l) + 1 + order_of_key(t->r, k);
    }

    int order_of_key(T k) { return order_of_key(root, k); }


    void print(Node *t) {
        if (!t) return;
        push(t);
        print(t->l);
        cout << "{" << t->key << ":" << t->val << "} ";
        print(t->r);
    }

    void print() {
        print(root);
        cout << '\n';
    }
};
