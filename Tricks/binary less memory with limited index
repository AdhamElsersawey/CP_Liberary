constexpr ll N = 4e6 + 2, M = 12, O = 1e9, mod = 1e9 + 7, OO = 1e18;

//---------------==================---------------//
int tr[N][2], ind[N];
int cnt = 0, BIT = 30;

void insert(int x, int id) {
    int u = 0;
    ind[0] = max(ind[0], id);
    for (int i = BIT; i >= 0; i--) {
        int b = (x >> i) & 1;
        if (!tr[u][b]) {
            tr[cnt][0] = tr[cnt][1] = 0;
            ind[cnt] = -1;
            tr[u][b] = cnt++;
        }
        u = tr[u][b];
        ind[u] = max(ind[u], id);
    }
}


int maxor(int x, int id) {
    if (cnt == 1) return 0;
    if (ind[0] < id)return 0;
    int u = 0;
    int res = 0;
    for (int i = 30; i >= 0; i--) {
        int b = (x >> i) & 1;
        if (tr[u][b ^ 1] && ind[tr[u][b ^ 1]] >= id) {
            res |= (1 << i);
            u = tr[u][b ^ 1];
        } else if (tr[u][b] && ind[tr[u][b]] >= id) {
            u = tr[u][b];
        } else break;
    }
    return res;
}


void GOAT() {
    int n, k;
    cin >> n >> k;
    vector<int> v(n);
    for (int &u: v)cin >> u;
    vector cost(n, vector<int>(n));
    cnt = 1;
    tr[0][0] = tr[0][1] = 0;
    ind[0] = -1;
    for (int j = 0; j < n; j++) {
        for (int p = 0; p <= j; p++) {
            insert(v[p] ^ v[j], p);
        }
        for (int p = 0; p <= j; p++) {
            cost[p][j] = maxor(v[p] ^ v[j], p);
        }
    }
    for (int len = 2; len <= n; len++) {
        for (int i = 0; i + len - 1 < n; i++) {
            int j = i + len - 1;
            cost[i][j] = max({cost[i][j], cost[i + 1][j], cost[i][j - 1]});
        }
    }
    vector dp(n + 1, vector<ll>(n + 1, -1));
    function<ll(int, int)> clac = [&](int i, int tk) {
        if (i == n)return tk == k ? 0ll : -OO;
        if (tk == k)return -OO;
        ll &ret = dp[i][tk];
        if (~ret)return ret;
        // ret = clac(i + 1, tk);
        ret = -OO;
        for (int j = i; j < n; j++) {
            ret = max(ret, clac(j + 1, tk + 1) + cost[i][j]);
        }
        return ret;
    };
    cout << clac(0, 0) << el;
}

