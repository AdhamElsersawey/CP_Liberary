  // how many number that submasks from the base <= upper
    auto calc = [&](int base,int upper) {
        ll ret = 0;
        for (int i = 30; ~i; --i) {
            if (upper >> i & 1) {
                ret += 1ll << __builtin_popcountll(base & ((1ll << i) - 1));
                if ((base >> i & 1) == 0)return ret;
            }
        }
        return ret + 1;
    };
