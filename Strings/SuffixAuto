struct sufauto {
    static const int A = 26;

    struct stat {
        int len = 0, lnk = -1, cnt = 0, firstpos = -1, sz = 0, lstpos = -2;
        bool clone = 0;
        array<int, A> nxt;
        stat() { nxt.fill(-1); }
    };

    vector<stat> t{{}};
    int lst = 0, o = 0;
    vector<int> dp;

    sufauto(const string &s) {
        for (auto i: s) insert(i);
        calc();
    }

    sufauto() {
    }

    void insert(char ce) {
        int c = ce - 'a', cur = t.size(), p = lst;
        t.push_back({});
        t[cur].len = t[p].len + 1;
        t[cur].firstpos = t[cur].len - 1; // the pos that string end at 0-base
        t[cur].lstpos = t[cur].len - 1;
        t[cur].cnt = 1;
        t[cur].lnk = 0;
        lst = cur;
        while (~p && t[p].nxt[c] == -1) {
            t[p].nxt[c] = cur;
            p = t[p].lnk;
        }
        if (p == -1) return;
        int q = t[p].nxt[c];
        if (t[q].len == t[p].len + 1) {
            t[cur].lnk = q;
            return;
        }
        int clo = t.size();
        t.push_back(t[q]);
        t[clo].len = t[p].len + 1;
        t[clo].clone = 1;
        t[clo].cnt = 0;
        while (~p && t[p].nxt[c] == q) {
            t[p].nxt[c] = clo;
            p = t[p].lnk;
        }
        t[q].lnk = t[cur].lnk = clo;
    }

    void calc() {
        int n = t.size();
        dp.resize(n + 2, -1);
        vector<int> ord(n - 1);


        iota(ord.begin(), ord.end(), 1);

        sort(ord.begin(), ord.end(), [&](int i, int j) {
            return t[i].len > t[j].len;
        });

        for (int i: ord) {
            t[t[i].lnk].cnt += t[i].cnt;
            /*
            if needed to know the positions
            t[t[i].lnk].firstpos = min(t[i].firstpos, t[t[i].lnk].firstpos);
            t[t[i].lnk].lstpos = max(t[i].lstpos, t[t[i].lnk].lstpos);
            */
        }
    }

    int move(int pos, char c) {
        return ~pos ? t[pos].nxt[c - 'a'] : -1;
    }

    // pre to calc the sz
    void dfss(int u = 0) {
        t[u].sz = t[u].cnt;
        // if distinct change the sz to 1
        for (auto v: t[u].nxt) {
            if (~v) {
                if (!t[v].sz)dfss(v);
                t[u].sz += t[v].sz;
            }
        }
    }

    // the number of distinct strings
    int dfs(int u = 0) {
        int &ret = dp[u];
        if (~ret)return ret;
        ret = 1;
        for (auto v: t[u].nxt) {
            if (~v)ret += dfs(v);
        }
        return ret;
    }

    // get the kth  the strings not distinct, call it with k-1
    void kth(string &ret,int k,int u = 0,int fr = 1) {
        if (fr)dfss();
        if (k < 0)return;
        for (char c = 'a'; c <= 'z'; ++c) {
            int v = t[u].nxt[c - 'a'];
            if (!~v)continue;
            if (t[v].sz <= k) {
                k -= t[v].sz;
            } else {
                ret.push_back(c), kth(ret, k - t[v].cnt, v, 0);
                // change cnt to 1 if distinct
                return;
            }
        }
    }

    int contains(const string &pat) {
        int curr = 0;
        for (char c: pat) {
            curr = move(curr, c);
            if (curr == -1) return 0;
        }
        return 1;
    }

    // O(|pat|)
    int count_occurrences(const string &pat) {
        int curr = 0;
        for (char c: pat) {
            curr = move(curr, c);
            if (curr == -1) return -1;
        }
        return (t[curr].cnt);
    }

    //lcs
    int maxmatch(string &pat) {
        int cur = 0, l = 0, ans = 0;
        for (auto c: pat) {
            c -= 'a';
            while (cur > 0 && t[cur].nxt[c] == -1) {
                cur = t[cur].lnk;
                if (~cur) l = t[cur].len;
            }
            if (~t[cur].nxt[c])cur = t[cur].nxt[c], ++l;
            else cur = l = 0;
            ans = max(ans, l);
        }
        return ans;
    }

    // the first pos that if we make rotation from it get the min string
    int get(int n) {
        // make s=s+s, n=s.size/2;
        ll cur = 0;
        for (int i = 0; i < n; i++) {
            for (int x: t[cur].nxt) {
                if (~x) {
                    cur = x;
                    break;
                }
            }
        }
        return t[cur].firstpos - n + 2;
    }

    int k_lcs(vector<string> &v) {
        int n = t.size();
        vector<int> mn(n);
        for (int i = 0; i < n; i++) {
            mn[i] = t[i].len;
        }
        vector<int> ord(n - 1);
        iota(all(ord), 1);
        sort(all(ord), [&](int i, int j) {
            return t[i].len > t[j].len;
        });
        for (auto &pat: v) {
            vector<int> nxt(n);
            int cur = 0, l = 0;
            for (auto c: pat) {
                c -= 'a';
                while (cur > 0 && t[cur].nxt[c] == -1) {
                    cur = t[cur].lnk;
                    if (~cur)l = t[cur].len;
                }
                if (~cur && ~t[cur].nxt[c])++l, cur = t[cur].nxt[c];
                else l = cur = 0;
                nxt[cur] = max(nxt[cur], l);
            }
            for (auto i: ord) {
                int lnk = t[i].lnk;
                if (~lnk) {
                    nxt[lnk] = max(nxt[lnk], min(t[lnk].len, nxt[i]));
                }
            }
            for (int i = 0; i < n; i++) {
                mn[i] = min(mn[i], nxt[i]);
            }
        }
        return *max_element(all(mn));
    }
};
